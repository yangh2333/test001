# PMO 平台环境变量配置
# 复制为 .env 并按需修改

# 运行环境
ENV=dev

# 数据库（默认 SQLite，零配置；生产可切换 PostgreSQL）
# SQLite: sqlite:///./pmo.db
# PostgreSQL: postgresql+psycopg://user:pass@localhost:5432/pmo
DATABASE_URL=sqlite:///./pmo.db

# JWT 密钥（生产请修改）
JWT_SECRET=pmo-dev-secret-change-me-please-2026
JWT_EXPIRE_MIN=480

# 导出水印
SECRECY_EXPORT_WATERMARK=PMO 平台 机密文件 仅限内部使用

# 外部集成（P1 留空不影响核心功能）
LDAP_URI=
WECOM_CORP_ID=
WECOM_SECRET=
WECOM_AGENT_ID=
AI_PROXY_URL=
AI_API_KEY_A=
AI_API_KEY_B=
CI_WEBHOOK_TOKEN=
